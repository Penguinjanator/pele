---
import ExampleCard from '../components/ExampleCard.astro';
import DocsLayout from '../layouts/DocsLayout.astro';
import { groups } from '../lib/example-groups';
import { examplesDescription, examplesTitle } from '../lib/examples';

const headings = groups.map((group) => ({ depth: 2, slug: group.slug, text: group.title }));

// The first line that is not front matter, a directive, or a comment: the diagram's own opening
// line. A pie chart may carry its title there, which is the chart's content and not its opening.
const opening = (source: string): string =>
  (source.replace(/^---\n[\s\S]*?\n---\n/, '').split('\n').map((line) => line.trim())
    .find((line) => line !== '' && !line.startsWith('%%')) ?? '').replace(/\s+title\s.*$/, '');
---

<DocsLayout current="examples" title={examplesTitle} description={examplesDescription} headings={headings} markdownPath="/examples.md">
  {groups.map((group) => (
    <>
      <h2 id={group.slug}>{group.title}</h2>
      {group.sources.map((source, index) => (
        <ExampleCard source={source} prefix={`${group.type}-${index}-`} label={opening(source)} code ariaLabel={`${group.title} diagram rendered by Pele`} />
      ))}
    </>
  ))}
</DocsLayout>

<script>
  import '../scripts/examples';
</script>
