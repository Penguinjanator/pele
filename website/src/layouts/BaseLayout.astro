---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/inter/wght-italic.css';
import '../styles/global.scss';
import { formatPageTitle } from '../lib/page-title';
import { siteDescription } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  markdownPath?: string;
}

const { title, description = siteDescription, markdownPath } = Astro.props;
const pageTitle = formatPageTitle(title);
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonicalUrl = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} title={`${title ?? 'Pele'} as Markdown`} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <title>{pageTitle}</title>
    <style is:inline>
      html[data-initial-hash] { scroll-behavior: auto; }
      a { color: inherit; text-decoration: none; }
      button.header-action { appearance: none; border: 1px solid transparent; outline: 0; background: transparent; color: inherit; font: inherit; }
    </style>
    <script is:inline>
      if (window.location.hash) {
        document.documentElement.dataset.initialHash = '';
        window.addEventListener('load', () => {
          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => delete document.documentElement.dataset.initialHash);
          });
        }, { once: true });
      }
    </script>
  </head>
  <body><slot /></body>
</html>

<script>
  import '../scripts/site';
</script>
