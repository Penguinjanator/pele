{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pele",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "pele.run",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
