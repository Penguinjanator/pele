{
  "name": "pele",
  "version": "2.0.0",
  "description": "A fast, lightweight Mermaid renderer that outputs themeable SVG.",
  "license": "MIT",
  "author": "kepano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kepano/pele.git"
  },
  "type": "module",
  "main": "./dist/pele.js",
  "module": "./dist/pele.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/pele.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/esm/core.js"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "import": "./dist/esm/lazy.js"
    },
    "./diagrams/*": {
      "types": "./dist/entries/*.d.ts",
      "import": "./dist/esm/diagrams/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./dist/pele.js",
    "./src/index.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test:watch": "vitest",
    "bench": "node scripts/bench.mjs",
    "website": "cd website && pnpm dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@mermaid-js/parser": "^2.0.1",
    "beautiful-mermaid": "^1.1.3",
    "esbuild": "^0.28.2",
    "jison": "^0.4.18",
    "js-yaml": "^4.3.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
